[Unit]
Description=FrameOS privileged door (request queue watcher)
Documentation=file:/srv/frameos/current/docs/buildroot-privileges.md
RequiresMountsFor=/srv/frameos

[Path]
# The unprivileged runtime drops one JSON file per request here
# (frameos/src/frameos/privileged.nim); the worker drains the directory and
# exits, and systemd triggers again if anything arrived meanwhile.
DirectoryNotEmpty=/srv/frameos/privileged/queue
MakeDirectory=yes
DirectoryMode=0755
Unit=frameos-privileged.service

[Install]
WantedBy=multi-user.target
