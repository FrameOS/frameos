[
  {
    "name": "init",
    "description": "Once per scene, when it is first loaded and its apps are ready — before its first open and render.",
    "canListen": true,
    "fields": []
  },
  {
    "name": "render",
    "description": "Render the scene. Triggered according to the frame's refresh interval, or when explicitly requested.",
