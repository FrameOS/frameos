{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@frameos/frontend#build": {
      "inputs": [
        "src/**",
        "public/**",
        "scripts/**",
        "schema/**",
        "build.mjs",
        "utils.mjs",
        "package.json",
        "tsconfig.json",
        "tailwind.config.js",
        "postcss.config.js",
        "../repo/**"
      ],
      "outputs": ["dist/**", "dist-editor/**"]
    },
    "frameos-editor#build": {
      "dependsOn": ["@frameos/frontend#build"],
      "inputs": ["scripts/**", "embed.js", "embed.d.ts", "package.json"],
      "outputs": ["dist/**"]
    },
    "frameos-wasm#build": {
      "inputs": [
        "src/**",
        "scripts/**",
        "tsconfig.json",
        "package.json",
        "../../frontend/public/frameos-wasm/**"
      ],
      "outputs": ["dist/**"]
    },
    "frameos-wasm#build:runtime": {
      "inputs": [
        "../src/wasm/**",
        "../src/frameos/**",
        "../frameos.nimble",
        "../tools/build_wasm.sh"
      ],
      "outputs": ["../../frontend/public/frameos-wasm/**"]
    },
    "@frameos-cloud/auth-web#build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "public/frameos-editor/**",
        "public/frameos-wasm/**"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
