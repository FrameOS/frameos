{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext", "ESNext.Array"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // The SPA bundles the frameos-wasm package from its source (the scene
    // workspace's preview, frontend/src/sceneWorkspace): no build of the
    // package has to run first. The cloud's auth-web resolves the built one.
    "paths": { "frameos-wasm": ["../frameos/wasm/src/index.ts"] }
  },
  // node-forge ships no types; frontend/ declares the module itself, and the
  // TLS helpers this bundle imports need that declaration here too.
  "include": ["src", "../frontend/src/types/node-forge.d.ts"]
}
