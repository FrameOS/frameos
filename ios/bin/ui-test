#!/usr/bin/env bash
# Runs the UI tests (ios/FrameOSUITests) on an iPhone simulator and copies
# every screenshot they keep into ios/ui-test-shots/.
#
#   ios/bin/ui-test                       # the sign-in screen only
#   FRAMEOS_UITEST_BACKEND=http://127.0.0.1:8997 ios/bin/ui-test
#                                         # + the tour of the whole app
#   FRAMEOS_UITEST_CLOUD=http://localhost:3000 FRAMEOS_UITEST_CLOUD_EMAIL=…
#   FRAMEOS_UITEST_CLOUD_PASSWORD=… ios/bin/ui-test
#                                         # + the tour on a cloud you may write to
#
# ios/bin/test-backend starts a throwaway backend for the tour. Extra
# arguments go to xcodebuild (-only-testing:FrameOSUITests/SignInUITests).
# FRAMEOS_UITEST_DEVICE picks the simulator by name (default: the newest
# iPhone); the app is uninstalled first, so each run starts signed out.
set -euo pipefail
cd "$(dirname "$0")/.."
command -v xcodegen >/dev/null || { echo "Install XcodeGen first: brew install xcodegen" >&2; exit 1; }
xcodegen generate --quiet

udid="$(xcrun simctl list devices available -j | python3 -c '
import json, os, sys
wanted = os.environ.get("FRAMEOS_UITEST_DEVICE", "")
devices = json.load(sys.stdin)["devices"]
phones = [d for runtime in sorted(devices) if "iOS" in runtime for d in devices[runtime]
          if d["name"].startswith("iPhone") and (not wanted or d["name"] == wanted)]
print(phones[-1]["udid"] if phones else "")
')"
[[ -n "$udid" ]] || { echo "No iPhone simulator: Xcode → Settings → Components, or xcodebuild -downloadPlatform iOS" >&2; exit 1; }
xcrun simctl boot "$udid" 2>/dev/null || true
xcrun simctl uninstall "$udid" net.frameos.app 2>/dev/null || true

results="DerivedData/ui-test.xcresult"
rm -rf "$results" ui-test-shots
status=0
# TEST_RUNNER_ variables reach the test process without the prefix.
TEST_RUNNER_FRAMEOS_UITEST_BACKEND="${FRAMEOS_UITEST_BACKEND:-}" \
TEST_RUNNER_FRAMEOS_UITEST_EMAIL="${FRAMEOS_UITEST_EMAIL:-}" \
TEST_RUNNER_FRAMEOS_UITEST_PASSWORD="${FRAMEOS_UITEST_PASSWORD:-}" \
TEST_RUNNER_FRAMEOS_UITEST_FRAME="${FRAMEOS_UITEST_FRAME:-}" \
TEST_RUNNER_FRAMEOS_UITEST_SCENE="${FRAMEOS_UITEST_SCENE:-}" \
TEST_RUNNER_FRAMEOS_UITEST_CLOUD="${FRAMEOS_UITEST_CLOUD:-}" \
TEST_RUNNER_FRAMEOS_UITEST_CLOUD_EMAIL="${FRAMEOS_UITEST_CLOUD_EMAIL:-}" \
TEST_RUNNER_FRAMEOS_UITEST_CLOUD_PASSWORD="${FRAMEOS_UITEST_CLOUD_PASSWORD:-}" \
TEST_RUNNER_FRAMEOS_UITEST_CLOUD_SCENE="${FRAMEOS_UITEST_CLOUD_SCENE:-}" \
xcodebuild test \
  -project FrameOS.xcodeproj \
  -scheme FrameOS \
  -destination "id=$udid" \
  -derivedDataPath DerivedData \
  -resultBundlePath "$results" \
  -only-testing:FrameOSUITests \
  CODE_SIGNING_ALLOWED=NO \
  "$@" 2>&1 | tee DerivedData/ui-test.log | grep -E "error:|Test Case .*(passed|failed|skipped)|\*\* TEST" || true
grep -q "\*\* TEST SUCCEEDED \*\*" DerivedData/ui-test.log || status=1

# The screenshots and the accessibility trees beside them.
mkdir -p ui-test-shots
xcrun xcresulttool export attachments --path "$results" --output-path ui-test-shots >/dev/null 2>&1 || true
if [[ -f ui-test-shots/manifest.json ]]; then
  python3 - <<'EOF'
import json, os, re
root = "ui-test-shots"
for test in json.load(open(os.path.join(root, "manifest.json"))):
    for item in test.get("attachments", []):
        name = item.get("suggestedHumanReadableName") or item["exportedFileName"]
        name = re.sub(r"_\d+_[0-9A-F-]{36}", "", name)
        src = os.path.join(root, item["exportedFileName"])
        if os.path.exists(src):
            os.replace(src, os.path.join(root, name))
EOF
fi
echo "Screenshots: ios/ui-test-shots/ ($(find ui-test-shots -name '*.png' | wc -l | tr -d ' '))"
exit $status
