{
  "id": "jsxForecast",
  "name": "JSX: week forecast",
  "settings": {
    "execution": "interpreted",
    "refreshInterval": 3600,
    "backgroundColor": "#0c4a6e"
  },
  "e2eFrame": {
    "width": 800,
    "height": 480
  },
  "fields": [],
  "apps": {
    "jsxUi": {
      "origin": "jsxUi",
      "name": "JSX: week forecast",
      "category": "data",
      "description": "A JSX interface (docs/jsx-ui.md).",
      "version": "1.0.0",
      "fields": [],
      "output": [
        {
          "name": "image",
          "type": "image"
        }
      ],
      "sources": {
        "config.json": "{\n  \"name\": \"JSX: week forecast\",\n  \"category\": \"data\",\n  \"description\": \"A JSX interface (docs/jsx-ui.md).\",\n  \"version\": \"1.0.0\",\n  \"fields\": [],\n  \"output\": [\n    {\n      \"name\": \"image\",\n      \"type\": \"image\"\n    }\n  ],\n  \"permissions\": []\n}\n",
        "app.tsx": "// A week of weather: icons drawn as SVG inside the UI, a bar for each range.\nconst Sun = () => (\n  <svg className=\"w-12 h-12 text-amber-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth={2} strokeLinecap=\"round\">\n    <circle cx={12} cy={12} r={4} fill=\"currentColor\" />\n    <path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\" />\n  </svg>\n)\nconst Cloud = ({ tone = 'text-slate-300' }) => (\n  <svg className={`w-12 h-12 ${tone}`} viewBox=\"0 0 24 24\">\n    <path fill=\"currentColor\" d=\"M7 18a5 5 0 0 1-.6-9.96A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9z\" />\n  </svg>\n)\nconst Rain = () => (\n  <svg className=\"w-12 h-12 text-sky-400\" viewBox=\"0 0 24 24\">\n    <path fill=\"#cbd5e1\" d=\"M7 14a5 5 0 0 1-.6-9.96A6 6 0 0 1 18 5a4.5 4.5 0 0 1-.5 9z\" />\n    <path stroke=\"currentColor\" strokeWidth={2} strokeLinecap=\"round\" d=\"M8 17l-1 3M12 17l-1 3M16 17l-1 3\" />\n  </svg>\n)\nconst days = [\n  { day: 'Today', icon: <Sun />, hi: 18, lo: 7 },\n  { day: 'Wed', icon: <Cloud />, hi: 15, lo: 8 },\n  { day: 'Thu', icon: <Rain />, hi: 11, lo: 6, rain: 12 },\n  { day: 'Fri', icon: <Rain />, hi: 9, lo: 4, rain: 5 },\n  { day: 'Sat', icon: <Cloud tone=\"text-slate-400\" />, hi: 12, lo: 3 },\n  { day: 'Sun', icon: <Sun />, hi: 16, lo: 5 },\n  { day: 'Mon', icon: <Sun />, hi: 19, lo: 9 },\n]\n\nexport function get(app) {\n  const min = 0, max = 20\n  return (\n    <div className=\"flex flex-col gap-4 p-6 bg-gradient-to-b from-sky-950 to-slate-900 text-white\">\n      <div className=\"flex items-end justify-between\">\n        <span className=\"text-3xl font-bold\">Brussels</span>\n        <span className=\"text-slate-400\">{`Rain Thursday and Friday · 17 mm`}</span>\n      </div>\n      <div className=\"flex-1 grid grid-cols-7 gap-3\">\n        {days.map((d, i) => (\n          <div className={`flex flex-col items-center gap-2 rounded-2xl py-4 ${i === 0 ? 'bg-white/15' : 'bg-white/5'}`}>\n            <span className={`text-lg ${i === 0 ? 'font-bold' : 'text-slate-300'}`}>{d.day}</span>\n            {d.icon}\n            <span className=\"text-2xl font-semibold\">{`${d.hi}°`}</span>\n            <div className=\"flex-1 w-2 rounded-full bg-white/10 relative\">\n              <div className={`absolute inset-x-0 rounded-full bg-gradient-to-b from-amber-300 to-sky-400 top-[${(max - d.hi) * 100 / (max - min)}%] bottom-[${(d.lo - min) * 100 / (max - min)}%]`} />\n            </div>\n            <span className=\"text-lg text-slate-400\">{`${d.lo}°`}</span>\n            <span className=\"text-xs text-sky-300 h-4\">{d.rain ? `${d.rain} mm` : ''}</span>\n          </div>\n        ))}\n      </div>\n    </div>\n  )\n}\n"
      }
    }
  },
  "nodes": [
    {
      "id": "render",
      "type": "event",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "keyword": "render"
      }
    },
    {
      "id": "ui",
      "type": "app",
      "position": {
        "x": 0,
        "y": 200
      },
      "data": {
        "keyword": "jsxUi",
        "config": {}
      }
    },
    {
      "id": "image",
      "type": "app",
      "position": {
        "x": 300,
        "y": 0
      },
      "data": {
        "keyword": "render/image",
        "config": {
          "placement": "stretch"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "render-image",
      "type": "appNodeEdge",
      "source": "render",
      "target": "image",
      "sourceHandle": "next",
      "targetHandle": "prev"
    },
    {
      "id": "ui-image",
      "type": "codeNodeEdge",
      "source": "ui",
      "target": "image",
      "sourceHandle": "fieldOutput",
      "targetHandle": "fieldInput/image"
    }
  ]
}
