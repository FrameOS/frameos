      ],
      "sources": {
        "config.json": "{\n  \"name\": \"JSX: departure board\",\n  \"category\": \"data\",\n  \"description\": \"A JSX interface (docs/jsx-ui.md).\",\n  \"version\": \"1.0.0\",\n  \"fields\": [],\n  \"output\": [\n    {\n      \"name\": \"image\",\n      \"type\": \"image\"\n    }\n  ],\n  \"permissions\": []\n}\n",
        "app.tsx": "// A departure board, portrait: line badges, destinations cut to fit, minutes.\nconst lines = {\n  '3': 'bg-amber-400 text-stone-900', '4': 'bg-rose-500 text-white',\n  '25': 'bg-sky-500 text-white', '71': 'bg-emerald-500 text-white', 'N': 'bg-violet-500 text-white',\n}\nconst departures = [\n  { line: '3', to: 'Churchill', via: 'Gare du Midi', min: 1 },\n  { line: '71', to: 'Delta', via: 'Flagey and the university campus', min: 3 },\n  { line: '4', to: 'Stalle (P)', via: 'Barrière de Saint-Gilles', min: 6, late: 2 },\n  { line: '25', to: 'Rogier', via: 'Boondael', min: 9 },\n  { line: '3', to: 'Esplanade', via: 'Gare du Nord', min: 11 },\n  { line: '71', to: 'De Brouckère', via: 'Porte de Namur', min: 14 },\n  { line: 'N', to: 'Noctis: Heysel', via: 'Night line', min: 42 },\n]\n\nexport function get(app) {\n  return (\n    <div className=\"flex flex-col bg-zinc-950 text-zinc-100\">\n      <div className=\"flex flex-col gap-1 px-6 pt-8 pb-6 bg-zinc-900 border-b border-zinc-800\">\n        <span className=\"text-sm uppercase text-zinc-500 font-semibold\">Departures</span>\n        <span className=\"text-4xl font-bold\">Bourse</span>\n        <span className=\"text-zinc-400\">{`Platform 2 · 14:40`}</span>\n      </div>\n      <div className=\"flex-1 flex flex-col\">\n        {departures.map((d, i) => (\n          <div className={`flex items-center gap-4 px-6 py-4 ${i % 2 ? 'bg-zinc-900/60' : ''}`}>\n            <span className={`w-12 h-12 rounded-lg flex items-center justify-center text-xl font-bold ${lines[d.line]}`}>{d.line}</span>\n            <div className=\"flex-1 flex flex-col\">\n              <span className=\"text-xl font-semibold truncate\">{d.to}</span>\n              <span className=\"text-sm text-zinc-500 truncate\">{`via ${d.via}`}</span>\n            </div>\n            <div className=\"flex flex-col items-end\">\n              <span className={`text-3xl font-bold ${d.min <= 2 ? 'text-amber-400' : ''}`}>{d.min}</span>\n              <span className={`text-xs uppercase ${d.late ? 'text-rose-400 font-semibold' : 'text-zinc-500'}`}>{d.late ? `+${d.late} min` : 'min'}</span>\n            </div>\n          </div>\n        ))}\n      </div>\n      <div className=\"px-6 py-3 text-sm text-zinc-500 border-t border-zinc-800 truncate\">Line 92 is diverted at Royale until Friday because of works on the rue de la Régence</div>\n    </div>\n  )\n}\n"
      }
    }
  },
  "nodes": [
    {
      "id": "render",
      "type": "event",
