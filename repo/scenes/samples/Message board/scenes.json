    "apps": {
      "unsplash": {
        "name": "Unsplash",
        "description": "Random Unsplash photo",
        "category": "data",
        "version": "1.0.0",
        "settings": ["unsplash"],
        "fields": [
          {
            "name": "search",
            "type": "string",
            "value": "nature",
            "label": "Search",
            "placeholder": "e.g. nature, birds"
          },
          {
            "name": "orientation",
            "type": "select",
            "value": "auto",
            "options": ["auto", "any", "landscape", "portrait", "squarish"],
            "label": "Orientation"
          },
          {
            "name": "metadataStateKey",
            "type": "string",
            "value": "",
            "label": "Metadata state key",
            "hint": "Stores {search, title, description, location, author, links, ...} under this key."
          },
          {
            "name": "saveAssets",
            "type": "select",
            "value": "auto",
            "options": ["auto", "always", "never"],
            "label": "Save asset",
            "hint": "Saves the image to the frame's assets folder. auto follows the frame's save-assets setting."
          }
        ],
        "output": [
          {
            "name": "image",
            "type": "image"
          }
        ],
        "cache": {
          "enabled": true,
          "inputEnabled": true,
          "durationEnabled": true,
          "duration": "900"
        },
        "origin": "repo/apps/image/unsplash",
        "sources": {
          "app.ts": "// A random Unsplash photo for a search; frameos.fetchImage decodes it natively.\nconst enc = (s) =>\n  encodeURIComponent(s)\n    .replace(/[!'()*]/g, (c) => '%' + c.charCodeAt(0).toString(16).toUpperCase())\n    .replace(/%20/g, '+')\nconst str = (v, d = '') => (typeof v === 'string' ? v : d)\n\nexport function get(app, context) {\n  const { config: c, frame: f } = app\n  // The size the photo is drawn at: the box it feeds, else the canvas. Both\n  // are in scene pixels, already turned with the frame.\n  const w = context.targetWidth || context.imageWidth || 0\n  const h = context.targetHeight || context.imageHeight || 0\n  if (!(w > 0 && h > 0)) throw new Error('No canvas to draw on: this app runs on render.')\n  const search = c.search.trim()\n  const stateKey = c.metadataStateKey.trim()\n  const fail = (m) => {\n    throw new Error(`Error fetching image from Unsplash: ${m}`)\n  }\n\n  const key = str(frameos.getSetting('unsplash', 'accessKey'))\n  if (!key) throw new Error('Please provide an Unsplash API key in the settings.')\n  const o = c.orientation\n  const orientation = o === 'auto' ? (h > w ? 'portrait' : w > h ? 'landscape' : 'squarish') : o === 'any' ? '' : o\n  const url = `https://api.unsplash.com/photos/random/?orientation=${enc(orientation)}&query=${enc(search)}`\n  if (f.debug) frameos.log(`API request: ${url}`)\n  const r = frameos.httpRequest(url, {\n    headers: { Authorization: `Client-ID ${key}`, 'Accept-Version': 'v1', 'Content-Type': 'application/json' },\n    timeoutMs: 60000,\n  })\n  if (!r.status) fail(r.error)\n  if (r.status !== 200) {\n    let detail = r.body\n    try {\n      const j = JSON.parse(r.body)\n      detail = str(j?.error?.message, str(j?.error, JSON.stringify(j)))\n    } catch {}\n    throw new Error(`Error making request ${r.status}: ${detail}`)\n  }\n  let j\n  try {\n    j = JSON.parse(r.body)\n  } catch (e) {\n    fail(e.message)\n  }\n  const raw = str(j?.urls?.raw)\n  if (!raw) throw new Error('No image URL returned from Unsplash.')\n  const imageUrl = `${raw}&w=${w}&h=${h}&fit=crop&crop=faces,edges`\n  const description = str(j.description, str(j.alt_description))\n  const meta = stateKey && {\n    source: 'unsplash',\n    search,\n    orientation,\n    imageUrl,\n    id: str(j.id),\n    title: str(j.slug, description),\n    description,\n    altDescription: str(j.alt_description),\n    location: str(j.location?.name),\n    createdAt: str(j.created_at),\n    photoUrl: str(j.links?.html),\n    author: str(j.user?.name),\n    authorUsername: str(j.user?.username),\n    authorUrl: str(j.user?.links?.html),\n  }\n  j = null\n\n  if (f.debug) frameos.log(`Downloading image: ${imageUrl}`)\n  const mode = c.saveAssets\n  const photo = frameos.fetchImage(imageUrl, {\n    saveAsset:\n      mode === 'auto' || mode === 'always' ? { name: `${search} ${w}x${h}`, extension: '.jpg', mode } : undefined,\n  })\n  if (!photo.image) fail(photo.error)\n  if (meta) frameos.setState(stateKey, meta)\n  return photo.image\n}\n",
          "config.json": "{\n  \"name\": \"Unsplash\",\n  \"description\": \"Random Unsplash photo\",\n  \"category\": \"data\",\n  \"version\": \"1.0.0\",\n  \"settings\": [\"unsplash\"],\n  \"fields\": [\n    { \"name\": \"search\", \"type\": \"string\", \"value\": \"nature\", \"label\": \"Search\", \"placeholder\": \"e.g. nature, birds\" },\n    {\n      \"name\": \"orientation\",\n      \"type\": \"select\",\n      \"value\": \"auto\",\n      \"options\": [\"auto\", \"any\", \"landscape\", \"portrait\", \"squarish\"],\n      \"label\": \"Orientation\"\n    },\n    {\n      \"name\": \"metadataStateKey\",\n      \"type\": \"string\",\n      \"value\": \"\",\n      \"label\": \"Metadata state key\",\n      \"hint\": \"Stores {search, title, description, location, author, links, ...} under this key.\"\n    },\n    {\n      \"name\": \"saveAssets\",\n      \"type\": \"select\",\n      \"value\": \"auto\",\n      \"options\": [\"auto\", \"always\", \"never\"],\n      \"label\": \"Save asset\",\n      \"hint\": \"Saves the image to the frame's assets folder. auto follows the frame's save-assets setting.\"\n    }\n  ],\n  \"output\": [{ \"name\": \"image\", \"type\": \"image\" }],\n  \"cache\": { \"enabled\": true, \"inputEnabled\": true, \"durationEnabled\": true, \"duration\": \"900\" }\n}\n"
        }
      }
    }
  }
