# /etc/frameos-cloud/backup.env — settings for frameos-cloud-backup.service.
# Seeded by ops/backup/install.sh on first install; never overwritten after.
#
# DATABASE_URL is deliberately NOT set here: the unit also loads
# /etc/frameos-cloud/auth-web.env and reuses the app's value, so there is no
# second copy of the password to keep in sync.

# Where rclone ships the backups. MUST be a crypt remote: the script refuses
# anything else, because a plaintext destination would put the env secrets
# in the host tarball on the Storage Box in clear. "boxcrypt" wraps the
# "storagebox" SFTP remote; both live in /root/.config/rclone/rclone.conf
# (see ops/backup/rclone.conf.example — the crypt passphrases are also in
# the password manager, and in no backup).
RCLONE_REMOTE=boxcrypt:backups

# Free-space check. A crypt remote passes `rclone about` through to the
# remote it wraps, so the default (the crypt remote itself) is fine; set this
# to the underlying remote if that ever stops working.
#CAPACITY_REMOTE=storagebox:

# Remote files older than this are pruned after each successful run.
RETENTION_DAYS=30

# Create a check at https://healthchecks.io (period: 1 day, grace: 6 hours)
# and paste its ping URL here. Without it a silently dead timer stays silent.
#HEALTHCHECKS_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# The nightly run also checks the pgBackRest stanza (status ok, newest base
# backup younger than this, WAL actually archived) and fails — i.e. pages on
# the check above — when the live layer is broken. 0 disables the check.
#PGBACKREST_STANZA=frameos
#PGBACKREST_MAX_AGE_HOURS=36

# --- object store (frameos-cloud-object-backup.service) --------------------
# Where the blob store is copied to, and where it is copied FROM. The source
# is an rclone remote, not the app's own S3 config; both live in
# /root/.config/rclone/rclone.conf.
OBJECT_STORE_REMOTE=r2:frameos-cloud
# Same crypt remote as above, different folder — the copy is encrypted too.
OBJECT_BACKUP_REMOTE=boxcrypt:objects

# Its own healthchecks.io check — a dead object backup and a dead database
# backup are different outages and should page separately.
#OBJECT_BACKUP_HEALTHCHECKS_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
