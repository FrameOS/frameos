[Unit]
Description=Nightly FrameOS Cloud object-store backup

[Timer]
# An hour after the database backup: the two are independent, but a restore
# needs both, and taking the object copy last means it can only ever be newer
# than the rows that reference it — never older, which is the direction that
# would leave a restored row pointing at bytes the backup never saw.
OnCalendar=*-*-* 05:17:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
