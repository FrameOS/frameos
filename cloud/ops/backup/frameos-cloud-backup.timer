[Unit]
Description=Nightly FrameOS Cloud backup

[Timer]
# 04:17 UTC: off the hour to avoid the top-of-hour cron stampede, and outside
# European evening peak when frames and users are most active.
OnCalendar=*-*-* 04:17:00 UTC
RandomizedDelaySec=15m
# Run on next boot if the box was down at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
