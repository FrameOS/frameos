# /etc/frameos-cloud/cleanup.env — retention overrides for scripts/db-cleanup.sh.
# DATABASE_URL comes from auth-web.env; nothing here is required.
#
# Bookkeeping rows (device-flow requests, login codes, sessions, claim
# tokens, finished commands): days before they are deleted.
#FRAMEOS_CLOUD_CLEANUP_RETENTION_DAYS=7
# Device telemetry (already capped per frame at insert): days kept.
#FRAMEOS_CLOUD_FRAME_LOG_RETENTION_DAYS=30
#FRAMEOS_CLOUD_FRAME_METRICS_RETENTION_DAYS=30
