{
  "name": "@frameos-cloud/scene-convert",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Converts legacy compiled FrameOS scenes (Nim code nodes, scene-local Nim apps) into interpreted JavaScript scenes: a deterministic Nim-expression pass, then a model pass for what is left.",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "frameos-scene-convert": "./bin/frameos-scene-convert.mjs"
  },
  "scripts": {
    "convert": "tsx src/cli.ts",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.9.2",
    "eslint": "^9.39.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
