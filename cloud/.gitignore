# Regenerated by Next on every `next dev` / `next build`, and its contents
# differ between the two (`.next/dev/types/routes.d.ts` vs
# `.next/types/routes.d.ts`). Tracking it meant `pnpm deploy:prod` — which
# builds — left the tree dirty, and the NEXT deploy then refused it as
# uncommitted work. create-next-app gitignores it for the same reason; tsc
# does not need it (verified with the file and .next/ both absent), and
# turbo runs auth-web#build before auth-web#typecheck anyway.
apps/auth-web/next-env.d.ts
apps/auth-web/evals/results/
