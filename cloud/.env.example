# Required now: public FrameOS app URL used for OAuth redirect URI construction.
# Production value: https://cloud.frameos.net
FRAMEOS_CLOUD_APP_URL=http://localhost:3000

# Account UI origin. Keep this on the same localhost URL in development;
# production uses https://account.frameos.net.
FRAMEOS_ACCOUNT_APP_URL=http://localhost:3000

# Scene Store origin. Keep this equal to FRAMEOS_CLOUD_APP_URL locally so all
# routes use one dev server/port. Production uses https://scenes.frameos.net.
FRAMEOS_SCENES_APP_URL=http://localhost:3000

# Production only: parent domain for the secure session cookie shared by
# cloud/account/scenes.frameos.net. Leave unset on localhost.
FRAMEOS_SESSION_COOKIE_DOMAIN=

# Optional. Number of trusted reverse proxies in front of the app. Rate limiting
# derives the client IP from the X-Forwarded-For entry appended by the closest
# trusted proxy; entries further left are client-controlled and ignored. Set to
# the exact number of proxies you run (default 1). Use 0 only if the app is
# exposed directly with no proxy.
RATE_LIMIT_TRUSTED_PROXY_COUNT=1
# Optional. Lifts the GitHub API budget used for FrameOS release lookups
# (browser flasher, SD image builder, device OTA polls) from 60/hour per
# egress IP to 5000/hour. Public read-only data: any token, no scopes needed.
# GITHUB_TOKEN=

# Optional: Google SSO. Create an OAuth 2.0 Client ID (type "Web application")
# in the Google Cloud Console and register the redirect URI:
# - Local: http://localhost:3000/api/auth/google/callback
# - Production: https://cloud.frameos.net/api/auth/google/callback
# With these unset, the login page hides the Google button and password
# sign-in keeps working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required now: server-side session signing. Generate with:
# openssl rand -base64 32
SESSION_SECRET=

# Required for persisted accounts, backend links, and device authorization.
# For local development, run `pnpm db:setup` inside Flox to start Postgres,
# create this database, apply migrations, and write `.env.local`.
DATABASE_URL=postgres://frameos_cloud:frameos_cloud@localhost:5432/frameos_cloud

# Required whenever Postgres is not on the same host: set to `require` so the
# connection is encrypted in transit (postgres.js defaults to no TLS). Note
# `require` encrypts but does not verify the server certificate; for a
# verified connection leave this empty and put `?sslmode=verify-full` on
# DATABASE_URL instead (DATABASE_SSL overrides the URL, and only `require` /
# `true` are understood here — see cloud/docs/deployment.md "Database TLS").
DATABASE_SSL=

# Required for encrypted linked-client credentials and token rotation.
# Generate with:
# openssl rand -base64 32
FRAMEOS_CLOUD_ENCRYPTION_KEY=

# Object storage for blobs — store scene zips, scene previews and gallery
# images, and the per-frame device-snapshot cache (src/lib/object-store.ts).
# With all three of endpoint/key/secret set, they go to Cloudflare R2; with any
# of them missing, they go to a directory on disk. Development wants the
# directory: no bucket, no credentials, no extra daemon, and `/db/` is already
# gitignored.
#
# Production values live in /etc/frameos-cloud/auth-web.env AND in
# /etc/frameos-cloud/frame-hub.env — the hub writes device snapshots through
# the same code, so a hub without these keys would keep writing bytes into
# Postgres while auth-web looks for them in R2.
#R2_CLOUD_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#R2_CLOUD_ACCESS_KEY_ID=
#R2_CLOUD_SECRET_ACCESS_KEY=
# Bucket name; defaults to frameos-cloud.
#R2_CLOUD_BUCKET=frameos-cloud
# Public alias in front of the bucket. Set it and PUBLIC store objects (a
# public scene's preview and gallery images) are served as a redirect to the
# CDN instead of proxied through Next. Private objects and every frame
# snapshot are always proxied, whatever this says.
#R2_CLOUD_PUBLIC_BASE_URL=https://cloud-cdn.frameos.net
# Filesystem driver root; defaults to db/object-storage at the repo root.
#FRAMEOS_OBJECT_STORE_DIR=

# Optional: transactional email for password reset links. With no token set,
# reset emails are written to the server log instead (local development).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=FrameOS Cloud <auth@frameos.net>

# Optional but strongly recommended for a public store: content moderation of
# store publishes (scene name, description, preview image) through OpenAI's
# free omni-moderation endpoint. With a key set, everything a user can put on
# a public page is classified before it is accepted (CSAM/sexual content,
# graphic violence, harassment/hate in text), and publishing fails closed if
# the moderation API is unreachable. With no key, checks are skipped.
# The same key also powers scene auto-categorization on publish
# (src/lib/store-classify.ts) — that path fails open: no key or an outage
# just leaves the scene uncategorized.
OPENAI_API_KEY=
# Chat model for scene auto-categorization; defaults to gpt-4o-mini.
#OPENAI_CLASSIFY_MODEL=

# Optional: Cloudflare Turnstile on the signup and password-reset forms
# (src/lib/turnstile.ts). Both halves or neither — a site key without a
# secret renders a widget whose answer is never checked. With both unset the
# widget is not rendered and verification is skipped, so local development
# needs no Cloudflare account. Create a widget at
# https://dash.cloudflare.com → Turnstile.
#
# Verification fails CLOSED: if Cloudflare is unreachable, signup and reset
# are refused rather than left unguarded.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics AND error tracking, both in one PostHog project (browser events,
# browser exceptions, and server-side reportError from src/lib/log.ts). One
# vendor on purpose: it is the only analytics subprocessor the privacy policy
# has to name. Browser capture is gated behind the consent banner; server
# error reports carry no user identity and run without consent.
NEXT_PUBLIC_POSTHOG_KEY=
#NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Required before opening signups to the public: the operator's legal
# identity, shown on /legal/imprint, /legal/terms and /legal/privacy. Those
# pages render a visible "[TO BE COMPLETED]" warning until FRAMEOS_LEGAL_
# ENTITY_NAME is set — deliberately, because a policy with a quietly missing
# controller name is worse than one that admits it is incomplete.
#
# These are facts about the deployment, not the code: a self-hoster running
# this AGPL codebase must never publish someone else's company as its own
# imprint. Belgian values shown as an example.
#
# QUOTE ANY VALUE CONTAINING A SPACE. On the server this file is both a
# systemd EnvironmentFile (which tolerates bare values) and something
# frameos-cloud-update `source`s as shell (which does not): an unquoted
#   FRAMEOS_LEGAL_ENTITY_NAME="Example Frames BV"
# makes the shell try to run `BV`, and the deploy dies mid-stream with a
# baffling "BV: command not found" followed by "tar: Write error".
FRAMEOS_LEGAL_ENTITY_NAME=
# Postal address; separate lines with "|" or real newlines.
FRAMEOS_LEGAL_ENTITY_ADDRESS=
FRAMEOS_LEGAL_ENTITY_COUNTRY=Belgium
# The natural person(s) representing the company.
FRAMEOS_LEGAL_REPRESENTATIVE=
# Belgian KBO/BCE enterprise number, e.g. 0123.456.789
FRAMEOS_LEGAL_COMPANY_NUMBER=
FRAMEOS_LEGAL_VAT_NUMBER=
# Where data-protection and legal notices are received.
FRAMEOS_LEGAL_CONTACT_EMAIL=
# Defaults to the Belgian DPA; override when established elsewhere.
#FRAMEOS_LEGAL_SUPERVISORY_AUTHORITY=
#FRAMEOS_LEGAL_SUPERVISORY_AUTHORITY_URL=

# Optional, and nothing sets it for you: the deploy writes the SHA to
# /opt/frameos-cloud/RELEASE as a file, not into the service environment. Set
# it here by hand if you want /healthz to report which release answered;
# /healthz omits the field entirely when it is unset.
#FRAMEOS_CLOUD_RELEASE=

# Optional: let the deployment's OPENAI_API_KEY also power the AI scene chat
# for accounts without their own key. Values: none (default) | superadmin |
# verified (verified publishers + superadmins) | all. A shared key is a
# shared bill — keep it narrow.
#FRAMEOS_AI_SHARED_KEY_ACCESS=verified
