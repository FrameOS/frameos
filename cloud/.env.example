# Required now: public FrameOS app URL used for OAuth redirect URI construction.
# Production value: https://cloud.frameos.net
FRAMEOS_CLOUD_APP_URL=http://localhost:3000

# Account UI origin. Keep this on the same localhost URL in development;
# production uses https://account.frameos.net.
FRAMEOS_ACCOUNT_APP_URL=http://localhost:3000

# Scene Store origin. Keep this equal to FRAMEOS_CLOUD_APP_URL locally so all
# routes use one dev server/port. Production uses https://scenes.frameos.net.
FRAMEOS_SCENES_APP_URL=http://localhost:3000

# Production only: parent domain for the secure session cookie shared by
# cloud/account/scenes.frameos.net. Leave unset on localhost.
FRAMEOS_SESSION_COOKIE_DOMAIN=

# Optional. Number of trusted reverse proxies in front of the app. Rate limiting
# derives the client IP from the X-Forwarded-For entry appended by the closest
# trusted proxy; entries further left are client-controlled and ignored. Set to
# the exact number of proxies you run (default 1). Use 0 only if the app is
# exposed directly with no proxy.
RATE_LIMIT_TRUSTED_PROXY_COUNT=1

# Optional: Google SSO. Create an OAuth 2.0 Client ID (type "Web application")
# in the Google Cloud Console and register the redirect URI:
# - Local: http://localhost:3000/api/auth/google/callback
# - Production: https://cloud.frameos.net/api/auth/google/callback
# With these unset, the login page hides the Google button and password
# sign-in keeps working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required now: server-side session signing. Generate with:
# openssl rand -base64 32
SESSION_SECRET=

# Required for persisted accounts, backend links, and device authorization.
# For local development, run `pnpm db:setup` inside Flox to start Postgres,
# create this database, apply migrations, and write `.env.local`.
DATABASE_URL=postgres://frameos_cloud:frameos_cloud@localhost:5432/frameos_cloud

# Required whenever Postgres is not on the same host: set to `require` so the
# connection is encrypted in transit (postgres.js defaults to no TLS).
DATABASE_SSL=

# Required for encrypted linked-client credentials and token rotation.
# Generate with:
# openssl rand -base64 32
FRAMEOS_CLOUD_ENCRYPTION_KEY=

# Optional: transactional email for password reset links. With no token set,
# reset emails are written to the server log instead (local development).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=FrameOS Cloud <auth@frameos.net>

# Optional but strongly recommended for a public store: content moderation of
# store publishes (scene name, description, preview image) through OpenAI's
# free omni-moderation endpoint. With a key set, everything a user can put on
# a public page is classified before it is accepted (CSAM/sexual content,
# graphic violence, harassment/hate in text), and publishing fails closed if
# the moderation API is unreachable. With no key, checks are skipped.
# The same key also powers scene auto-categorization on publish
# (src/lib/store-classify.ts) — that path fails open: no key or an outage
# just leaves the scene uncategorized.
OPENAI_API_KEY=
# Chat model for scene auto-categorization; defaults to gpt-4o-mini.
#OPENAI_CLASSIFY_MODEL=
