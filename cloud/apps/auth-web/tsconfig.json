{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "jsx": "preserve",
    "module": "ESNext",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // Renders the legacy workspace's FrameActionsMenu, whose import graph
    // (frontend/src components) predates this package's strict compiler
    // options. Vitest still runs it; only tsc leaves it out.
    "src/test/shared-spa/esp32-frame-controls.test.tsx",
    // Same story: mounts the real framesModel, whose import graph reaches
    // the legacy workspace components (bare JSX namespace, pre-strict
    // typing). Vitest still runs it; only tsc leaves it out.
    "src/test/shared-spa/cloud-scene-deploy.test.ts",
    // Same story again, and the widest graph of the three: it renders the
    // whole deploy drawer. Vitest still runs it; only tsc leaves it out.
    // (frontend/ typechecks these components itself with its own config.)
    "src/test/shared-spa/cloud-deploy-dialog.test.tsx",
    // Same story: mounts EmbeddedWebFlasher, whose import graph reaches the
    // legacy workspace components (bare JSX namespace, pre-strict typing).
    // Vitest still runs it; only tsc leaves it out.
    "src/test/shared-spa/embedded-web-flasher.test.tsx",
    // Same story: mounts EmbeddedReleaseFlasher, whose import graph reaches
    // the legacy workspace components through framesModel.
    // Vitest still runs it; only tsc leaves it out.
    "src/test/shared-spa/embedded-release-flasher.test.tsx",
    // Same story: builds every logic the embedded editor mounts, and
    // workspaceLogic's import graph reaches the legacy workspace components
    // (FrameConnectionDot's bare JSX namespace). Vitest still runs it; only
    // tsc leaves it out.
    "src/test/shared-spa/embedded-editor-logics.test.ts",
    // Same story: frameStatusGroups imports decorators/frame.tsx, which
    // renders the legacy connection dot/spinner components (bare JSX
    // namespace). Vitest still runs it; only tsc leaves it out.
    "src/test/shared-spa/frame-status-groups.test.ts",
    // Same story: the check-in helpers live in decorators/frame.tsx too.
    "src/test/shared-spa/frame-checkin.test.ts",
    // Same story: importing frameLogic pulls in framesModel and the
    // decorators behind it, so the graph reaches those same legacy
    // components. Vitest still runs it; only tsc leaves it out.
    "src/test/shared-spa/cloud-frame-change-details.test.ts",
    "src/test/shared-spa/cloud-frame-scenes-loading.test.ts",
    "src/test/shared-spa/cloud-scene-persist-equality.test.ts",
    "src/test/shared-spa/scene-origin.test.ts",
    "src/test/shared-spa/embedded-editor-scene-sanitize.test.ts",
    // Same story from the other direction: it imports metricsLogic directly
    // for the metric-card hash helpers, and metricsLogic builds RebootMarker
    // objects with optional fields spelled as `undefined` — legal under the
    // frontend's tsconfig, not under this one's exactOptionalPropertyTypes.
    // Nothing else in auth-web reaches that module. Vitest still runs it;
    // only tsc leaves it out.
    "src/test/shared-spa/battery-misreads.test.ts",
    // Same story: chartData's types come from metricsLogic, and the module
    // itself indexes sorted arrays the way the frontend's tsconfig allows
    // (no noUncheckedIndexedAccess). Vitest still runs it; only tsc leaves
    // it out.
    "src/test/shared-spa/metrics-chart-data.test.ts",
    "src/test/shared-spa/metrics-brush-chart.test.tsx",
    // The widest graph of the lot: it mounts the whole FrameSettings panel,
    // which reaches the colour picker and every device-settings component
    // behind it. Vitest still runs it; only tsc leaves it out.
    "src/test/shared-spa/cloud-frame-settings-panel.test.tsx"
  ]
}
