{
  "name": "frameos-cloud",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "admin:grant": "scripts/grant-superadmin.sh",
    "dev": "pnpm --filter @frameos-cloud/auth-web dev",
    "build": "pnpm --filter @frameos-cloud/auth-web build",
    "db:cleanup": "scripts/db-cleanup.sh",
    "db:migrate": "scripts/db-migrate.sh",
    "db:setup": "scripts/db-setup.sh",
    "deploy:prod": "scripts/deploy.sh",
    "editor:build": "scripts/build-editor.sh",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @frameos-cloud/auth-web test:integration",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.1.8"
  }
}
