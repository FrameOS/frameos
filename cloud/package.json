{
  "name": "frameos-cloud",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "admin:grant": "scripts/grant-superadmin.sh",
    "dev": "pnpm --filter @frameos-cloud/auth-web dev",
    "dev:hub": "pnpm --filter @frameos-cloud/frame-hub dev",
    "build": "turbo run build --filter=@frameos-cloud/auth-web --filter=@frameos-cloud/frame-hub",
    "db:cleanup": "scripts/db-cleanup.sh",
    "db:migrate": "scripts/db-migrate.sh",
    "db:setup": "scripts/db-setup.sh",
    "deploy:install": "scripts/install-deploy.sh",
    "deploy:prod": "scripts/deploy.sh",
    "lint": "turbo run lint --filter='@frameos-cloud/*'",
    "test": "turbo run test --filter='@frameos-cloud/*'",
    "test:integration": "pnpm --filter @frameos-cloud/auth-web test:integration && pnpm --filter @frameos-cloud/frame-hub test:integration && pnpm --filter @frameos-cloud/ledger test:integration",
    "typecheck": "turbo run typecheck --filter='@frameos-cloud/*'",
    "verify": "turbo run lint typecheck test build --filter='@frameos-cloud/*'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.1.8"
  }
}
