CONFIG_IDF_TARGET="esp32s3"

# Console: UART0 primary, the chip's USB-Serial/JTAG device secondary. Boards
# bring USB-C to different places — the S3's own USB pins (XIAO ESP32-S3:
# "USB JTAG/serial debug unit"), a USB-UART bridge on UART0 (Seeed reTerminal
# E10xx: CH340, the USB pins are not wired at all), or both over one cable
# (PhotoPainter 13.3") — and one image has to answer on whichever port the
# host can see. stdout reaches both (the console VFS mirrors writes to the
# secondary); fos_console.c reads commands from both drivers.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set

# Smaller, quieter image
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# CONFIG_APP_COMPILE_TIME_DATE is not set
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
# CONFIG_MBEDTLS_ERROR_STRINGS is not set

# Text the image carries only to explain its own failures. The linker merges
# every string literal into one pool (the ~180K the size report attributes to
# `esp_efuse_utility.c.obj`), and three kinds of it buy little on a frame that
# reports faults over the cloud link:
#
#   ASSERTIONS_SILENT   assertions still abort, they just no longer carry the
#                       expression text and __FILE__ path (~29K of the pool
#                       was `blk >= 0 && blk < EFUSE_BLK_MAX`-style strings
#                       plus `//IDF/components/...` paths). A failed assert
#                       prints its address; decode it against the .elf with
#                       `xtensa-esp32s3-elf-addr2line -e frameos_esp32.elf`.
#   CHECKS_SILENT       drops the message in ESP_RETURN_ON_*/ESP_EXIT_ON_*.
#                       FrameOS' own C uses those macros four times; the rest
#                       is ESP-IDF internals.
#   ERR_TO_NAME_LOOKUP  esp_err_to_name() falls back to "ERROR 0x105" instead
#                       of "ESP_ERR_NOT_FOUND" — the numeric code still
#                       reaches the log, and it is the code we grep for.
#
# Assertions themselves stay ENABLED: only their strings go.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
# CONFIG_ESP_ERR_TO_NAME_LOOKUP is not set

# 8MB flash (Seeed XIAO ESP32-S3 and similar S3 modules), OTA A/B layout.
# The default table gives each OTA slot 3520K (3.44MiB) and keeps a 1M
# SPIFFS state partition for scenes/user data. Larger flash profiles keep
# roughly 4MB OTA slots and dedicate the remaining flash to state storage; the
# 32MB profile also raises SPIFFS page size so its 24M state partition mounts.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Quad I/O flash reads. The S3 runs every instruction from flash through a
# 16 KB cache, and in DIO mode a cache miss moves two bits a clock: DVD Logo
# Bounce on the SenseCAP Indicator ran 10.2 fps in DIO and 13.5 in QIO
# (2026-10-25), as fast as a 32 KB instruction cache, which would cost 16 KB
# of internal RAM. The image header still says DIO; the bootloader switches
# the flash to quad itself (an octal flash is left alone). A flash that
# refuses its QE bit does NOT fall back to DIO: the bootloader drops to slow
# reads and the app's flash init asserts, so a board flashed over USB
# boot-loops (an updated one rolls back to its old app). QEMU's flash is such
# a chip, so the smoke boots a DIO build (sdkconfig.qemu.defaults); bench a
# new S3 board before it ships with this image. Only a USB flash replaces the
# bootloader: a frame updated over the air keeps its DIO one, and its speed.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# app_main mounts and may format SPIFFS during first boot. ESP-IDF's default
# 3584-byte main task stack can overflow in that path before FrameOS reaches
# Wi-Fi or OTA rollback validation.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# OTA rollback: a freshly updated image must mark itself valid after booting,
# otherwise the bootloader rolls back to the previous slot on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 8MB octal PSRAM (XIAO ESP32-S3). Big allocations (framebuffers, Nim heap)
# go to PSRAM via malloc; small/hot ones stay in internal SRAM.
CONFIG_SPIRAM=y
# No PSRAM memory test at boot: it read and wrote all 8 MB on every boot,
# deep-sleep wakes included, 0.41 s of it on the E1002 (2026-10-16: the
# button task now starts 0.75 s after the reset instead of 1.18 s). The keys
# are blind until then, so it cost the second tap of a double press that woke
# the frame. A bad PSRAM still fails loudly in use.
# CONFIG_SPIRAM_MEMTEST is not set
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# XIAO's PSRAM is not on the same supply rail quirk as some devkits; ignore
# the bootup test failing on boards without PSRAM instead of aborting.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# 64-byte data cache lines, in the same 32 KB: half the PSRAM transactions
# for whatever streams through the cache. On the SenseCAP Indicator that is
# a lot: the LCD refill copies 19.2 KB out of PSRAM every 0.9 ms, and a Ken
# Burns frame reads its photo and writes 460 KB. That frame's draw went from
# 115 to 90 ms (2026-10-26).
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# HTTPS to arbitrary backends: bundled CA roots; plain HTTP allowed for LAN dev.
# The "common" bundle (43 roots: ISRG/Let's Encrypt, DigiCert, Amazon, Google,
# GlobalSign, Sectigo, GoDaddy, IdenTrust, ...) covers every public CA our
# endpoints use and is ~45KB smaller than the full bundle. Private CAs were
# never in the full bundle either.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
# HTTPS renders happen after Nim/QuickJS have consumed most internal SRAM.
# Put mbedTLS' large dynamic buffers in PSRAM so image/data apps can fetch
# public HTTPS APIs reliably on 8MB PSRAM boards.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set

# Wi-Fi provisioning portal posts can carry long headers/forms
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# The Nim render task does real work; don't trip the watchdog on long e-ink
# refreshes (the busy-wait yields, but first renders can be slow).
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Long filenames on the SD assets mount. Without this FatFs runs in 8.3 mode
# and the cloud assets_list reports names like 02_SYS~1 — technically real,
# humanly useless. Heap allocation (not stack): the lookups run on tasks with
# tight stacks, and the 255-char buffer only exists while a path op runs.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# fos_netguard pins a scene request's connect to the address its check
# resolved: lwIP asks this hook before every DNS query, and the task holding a
# pin gets the checked address back instead of a second (rebindable) answer.
CONFIG_LWIP_HOOK_NETCONN_EXT_RESOLVE_CUSTOM=y

# The RGB LCD of the SenseCAP Indicator (lcd_st7701s_rgb.c): restart the
# scan-out DMA at every vertical blank, so a frame the DMA could not feed in
# time (a flash write holds its fill interrupt) is one disturbed frame, not a
# picture that creeps down the glass until the next reboot. No effect on
# chips without the RGB LCD peripheral.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
