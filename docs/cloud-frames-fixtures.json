{
  "$comment": [
    "Conformance cases for the cloud verb contract (docs/cloud-frames-contract.json).",
    "Every implementation of the device side of `set_settings` runs them:",
    "  Linux runtime  frameos/src/frameos/cloud/tests/test_cloud_contract.nim",
    "  ESP32 firmware embedded/esp32/main/tests/test_fos_cloud_contract.c (host build)",
    "  cloud          cloud/apps/auth-web/src/test/cloud-frames-contract.test.ts",
    "A `settings` case is the object a set_settings push carries; `expect`",
    "is the verdict per profile: \"ok\", or the error token the push is refused",
    "with. `verbs` cases check the verb table (Linux runtime + cloud)."
  ],
  "settings": [
    {"name": "base six on both profiles",
     "settings": {"name": "Kitchen", "rotate": 90, "interval": 300, "scaling_mode": "cover"},
     "expect": {"linux": "ok", "esp32": "ok"}},
    {"name": "timezone and debug (esp32 from 2026.8.34 / 2026.8.31)",
     "settings": {"timezone": "Europe/Brussels", "debug": true},
     "expect": {"linux": "ok", "esp32": "ok"}},
    {"name": "empty object is a malformed push",
     "settings": {},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "an unknown key refuses the whole push",
     "settings": {"name": "Kitchen", "brightness": 50},
     "expect": {"linux": "setting_not_allowed", "esp32": "setting_not_allowed"}},
    {"name": "service settings never ride this verb",
     "settings": {"openAI": {"apiKey": "sk-x"}},
     "expect": {"linux": "setting_not_allowed", "esp32": "setting_not_allowed"}},
    {"name": "network access is not a setting",
     "settings": {"network": {"allowLocalNetworkAccess": true}},
     "expect": {"linux": "setting_not_allowed", "esp32": "setting_not_allowed"}},
    {"name": "power keys exist only on the chip",
     "settings": {"deep_sleep": true, "deep_sleep_on_battery": false, "wake_check_seconds": 900,
                  "battery_pin": 1, "battery_divider": 2.0, "battery_enable_pin": 21},
     "expect": {"linux": "setting_not_allowed", "esp32": "ok"}},
    {"name": "the Linux extended batch does not exist on the chip",
     "settings": {"flip": "horizontal", "metrics_interval": 60},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "one refused key takes the good ones down with it",
     "settings": {"interval": 60, "flip": "horizontal"},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "name must be a non-empty string",
     "settings": {"name": ""},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "name cannot be a number",
     "settings": {"name": 5},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "rotate is one of four values",
     "settings": {"rotate": 45},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "rotate is an integer, not a string",
     "settings": {"rotate": "90"},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "interval within a day",
     "settings": {"interval": 86401},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "interval may be fractional",
     "settings": {"interval": 2.5},
     "expect": {"linux": "ok", "esp32": "ok"}},
    {"name": "interval below one",
     "settings": {"interval": 0},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "scaling_mode is an enum",
     "settings": {"scaling_mode": "fill"},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "timezone is an IANA name",
     "settings": {"timezone": "not a zone; drop table"},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "timezone with a slash path",
     "settings": {"timezone": "America/Argentina/Buenos_Aires"},
     "expect": {"linux": "ok", "esp32": "ok"}},
    {"name": "timezone at most 64 characters",
     "settings": {"timezone": "Europe/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "timezone_data rides with timezone on the chip",
     "settings": {"timezone": "Europe/Tallinn", "timezone_data": {"timezones": {}, "dstChanges": {}}},
     "expect": {"linux": "setting_not_allowed", "esp32": "ok"}},
    {"name": "timezone_data may be null (fetch it yourself)",
     "settings": {"timezone": "UTC", "timezone_data": null},
     "expect": {"linux": "setting_not_allowed", "esp32": "ok"}},
    {"name": "timezone_data alone is refused",
     "settings": {"timezone_data": {"timezones": {}}},
     "expect": {"linux": "setting_not_allowed", "esp32": "invalid_settings"}},
    {"name": "timezone_data must be an object or null",
     "settings": {"timezone": "UTC", "timezone_data": "slice"},
     "expect": {"linux": "setting_not_allowed", "esp32": "invalid_settings"}},
    {"name": "debug is a bool",
     "settings": {"debug": "yes"},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "flip enum",
     "settings": {"flip": "diagonal"},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "flip empty string is allowed",
     "settings": {"flip": ""},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "error_behavior with every key",
     "settings": {"error_behavior": {"mode": "silent_retry", "retry_seconds": 300, "silent_retry_seconds": 60,
                                     "show_error_retry_seconds": 120, "silent_retry_forever": false, "silent_window_minutes": 30}},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "error_behavior refuses an unknown sub-key",
     "settings": {"error_behavior": {"mode": "silent_retry", "retryForever": true}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "error_behavior mode enum",
     "settings": {"error_behavior": {"mode": "panic"}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "error_behavior retry ceiling",
     "settings": {"error_behavior": {"retry_seconds": 86401}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "error_behavior must be an object",
     "settings": {"error_behavior": "silent_retry"},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "control_code full shape",
     "settings": {"control_code": {"enabled": true, "position": "bottom-right", "size": 2.5, "padding": 5,
                                   "offsetX": -10, "offsetY": 10, "qrCodeColor": "#000000", "backgroundColor": "#ffffff"}},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "control_code colour must be #rrggbb",
     "settings": {"control_code": {"qrCodeColor": "black"}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "control_code padding is an integer",
     "settings": {"control_code": {"padding": 2.5}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "control_code position enum",
     "settings": {"control_code": {"position": "middle"}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "metrics_interval zero disables",
     "settings": {"metrics_interval": 0},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "metrics_interval negative",
     "settings": {"metrics_interval": -1},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "max_http_response_bytes at the Linux floor",
     "settings": {"max_http_response_bytes": 65536},
     "expect": {"linux": "ok", "esp32": "ok"}},
    {"name": "max_http_response_bytes below the Linux floor is fine for the chip",
     "settings": {"max_http_response_bytes": 4096},
     "expect": {"linux": "invalid_settings", "esp32": "ok"}},
    {"name": "max_http_response_bytes below the chip floor",
     "settings": {"max_http_response_bytes": 512},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "max_http_response_bytes above 64 MiB",
     "settings": {"max_http_response_bytes": 67108865},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "max_http_response_bytes is an integer",
     "settings": {"max_http_response_bytes": 1048576.5},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "save_assets as one switch",
     "settings": {"save_assets": true},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "save_assets as a per-app map",
     "settings": {"save_assets": {"unsplash": true, "openaiImage": false}},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "save_assets map values are bools",
     "settings": {"save_assets": {"unsplash": "yes"}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "save_assets map key cannot be empty",
     "settings": {"save_assets": {"": true}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "timezone_updater enabled and hour",
     "settings": {"timezone_updater": {"enabled": true, "hour": 3}},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "timezone_updater never takes a URL",
     "settings": {"timezone_updater": {"enabled": true, "url": "https://evil.example/tz"}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "timezone_updater hour 0..23",
     "settings": {"timezone_updater": {"hour": 24}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "palette with names",
     "settings": {"palette": {"name": "Spectra 6", "colors": ["#000000", "#ffffff", "#ff0000"], "colorNames": ["black", "white", "red"]}},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "palette empty colours hands the panel its built-in palette",
     "settings": {"palette": {"colors": []}},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "palette requires colors",
     "settings": {"palette": {"name": "x"}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "palette colours are #rrggbb",
     "settings": {"palette": {"colors": ["red"]}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "palette colorNames must match colors one to one",
     "settings": {"palette": {"colors": ["#000000", "#ffffff"], "colorNames": ["black"]}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "palette at most 16 colours",
     "settings": {"palette": {"colors": ["#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000"]}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "palette refuses a lookup table",
     "settings": {"palette": {"colors": ["#000000"], "lut": [1, 2, 3]}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "device_config partial-refresh policy",
     "settings": {"device_config": {"partial": true, "partialMaxAreaPercent": 40, "partialMaxRefreshesBeforeFull": 10}},
     "expect": {"linux": "ok", "esp32": "setting_not_allowed"}},
    {"name": "device_config must carry at least one key",
     "settings": {"device_config": {}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "device_config is strictly the partial-refresh policy",
     "settings": {"device_config": {"partial": true, "vcom": -1.5}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "device_config refresh count is an integer",
     "settings": {"device_config": {"partialMaxRefreshesBeforeFull": 1.5}},
     "expect": {"linux": "invalid_settings", "esp32": "setting_not_allowed"}},
    {"name": "gpio_buttons on both profiles",
     "settings": {"gpio_buttons": [{"pin": 3, "label": "next"}, {"pin": 4, "label": "previous"}]},
     "expect": {"linux": "ok", "esp32": "ok"}},
    {"name": "gpio_buttons empty list unbinds every button",
     "settings": {"gpio_buttons": []},
     "expect": {"linux": "ok", "esp32": "ok"}},
    {"name": "gpio_buttons duplicate pin",
     "settings": {"gpio_buttons": [{"pin": 3, "label": "a"}, {"pin": 3, "label": "b"}]},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "gpio_buttons label is required",
     "settings": {"gpio_buttons": [{"pin": 3}]},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "gpio_buttons label cannot be blank",
     "settings": {"gpio_buttons": [{"pin": 3, "label": "   "}]},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "gpio_buttons label cannot carry a colon or newline",
     "settings": {"gpio_buttons": [{"pin": 3, "label": "a:b"}]},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "gpio_buttons pin range",
     "settings": {"gpio_buttons": [{"pin": 49, "label": "x"}]},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "gpio_buttons refuses an unknown button key",
     "settings": {"gpio_buttons": [{"pin": 3, "label": "x", "pull": "up"}]},
     "expect": {"linux": "invalid_settings", "esp32": "invalid_settings"}},
    {"name": "gpio_buttons: nine buttons fit the Pi, not the chip",
     "settings": {"gpio_buttons": [{"pin": 1, "label": "a"}, {"pin": 2, "label": "b"}, {"pin": 3, "label": "c"},
                                   {"pin": 4, "label": "d"}, {"pin": 5, "label": "e"}, {"pin": 6, "label": "f"},
                                   {"pin": 7, "label": "g"}, {"pin": 8, "label": "h"}, {"pin": 9, "label": "i"}]},
     "expect": {"linux": "ok", "esp32": "invalid_settings"}},
    {"name": "wake_check_seconds zero means only wake to render",
     "settings": {"wake_check_seconds": 0},
     "expect": {"linux": "setting_not_allowed", "esp32": "ok"}},
    {"name": "wake_check_seconds within a day",
     "settings": {"wake_check_seconds": 86401},
     "expect": {"linux": "setting_not_allowed", "esp32": "invalid_settings"}},
    {"name": "battery_pin -1 means no battery",
     "settings": {"battery_pin": -1},
     "expect": {"linux": "setting_not_allowed", "esp32": "ok"}},
    {"name": "battery_pin above the GPIO range",
     "settings": {"battery_pin": 49},
     "expect": {"linux": "setting_not_allowed", "esp32": "invalid_settings"}},
    {"name": "battery_divider ratio bounds",
     "settings": {"battery_divider": 0.1},
     "expect": {"linux": "setting_not_allowed", "esp32": "invalid_settings"}},
    {"name": "battery_enable_pin is an integer",
     "settings": {"battery_enable_pin": "21"},
     "expect": {"linux": "setting_not_allowed", "esp32": "invalid_settings"}},
    {"name": "deep_sleep is a bool",
     "settings": {"deep_sleep": 1},
     "expect": {"linux": "setting_not_allowed", "esp32": "invalid_settings"}}
  ],
  "verbs": [
    {"name": "shell is not a verb", "type": "shell", "expect": "unknown_verb"},
    {"name": "exec is not a verb", "type": "exec", "expect": "unknown_verb"},
    {"name": "file_write is not a verb", "type": "file_write", "expect": "unknown_verb"},
    {"name": "get_logs needs telemetry:logs", "type": "get_logs", "scopes": [], "expect": "insufficient_scope"},
    {"name": "get_metrics needs telemetry:metrics", "type": "get_metrics", "scopes": ["telemetry:logs"], "expect": "insufficient_scope"},
    {"name": "refresh_service_settings needs settings:services", "type": "refresh_service_settings", "scopes": [], "expect": "insufficient_scope"}
  ]
}
