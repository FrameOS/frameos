{
  "$comment": "The scene event contract: every built-in event name, what it carries, who may emit it and what a host does with it. Source of truth for frameos/tools/generate_events_contract.py, which writes the Nim, C, TypeScript and Python tables and the editor catalog (frontend/schema/events.json). The prose is docs/events.md; the conformance corpus every runner must pass is docs/event-fixtures.json. Add an event HERE, regenerate, add a fixture — never to one of the generated files.",
  "version": 1,
  "hosts": ["linux", "esp32", "wasm"],
  "origins": {
    "driver": "An input driver on the frame (evdev, gpioButton, the ESP32 button task).",
    "preview": "The browser preview's canvas and buttons.",
    "scene": "A scene's own `dispatch` node.",
    "schedule": "A schedule entry firing on the frame.",
    "http:write": "The frame's HTTP API with the frame access key (or `public` access): POST /event/<name>.",
    "http:admin": "The frame's HTTP API with an admin session or the serverApiKey bearer — the self-hosted backend.",
    "cloud": "FrameOS Cloud, through a hub verb.",
    "system": "The runtime itself: boot, the portal, settings apply, device flow."
  },
  "classes": {
    "lifecycle": "Sent by the host to a scene as it is loaded, shown, rendered and left.",
    "input": "Something a person did: a key, a pointer, a button.",
    "scene-command": "Asks the host to do something for the current scene; a scene may dispatch it.",
    "device-command": "Asks the runtime to do something to the device. Never delivered to a scene, never offered by the editor."
  },
  "customEvents": {
    "$comment": "A name that is not in `events` is a custom scene event (a scene's `customEvents`). Every host delivers it to the current scene's listeners of that name. `origins` is who may always send one; `declarableOrigins` are the ones a scene opts into per event, with `origins` on its declaration (`{name: \"nextPage\", origins: [\"schedule\"]}`).",
    "maxNameLength": 63,
    "origins": ["driver", "preview", "scene", "http:write", "http:admin", "system"],
    "declarableOrigins": ["schedule", "cloud"],
    "cloud": {"verb": "scene_event", "since": "2026.9.21"},
    "renderAfter": "if-state-changed",
    "coalesce": "none",
    "log": "full"
  },
  "pointer": {
    "$comment": "Driver / preview -> host: both axes 0..wireMax across the panel, whatever the device reports. The host scales into scene pixels before a scene sees it, and every pointer event a scene hears carries the position. `types` is `pointerType`; `buttons` is what the `button` number and the `buttons` bitmask (1 << button) mean.",
    "wireMax": 32767,
    "types": ["mouse", "touch", "pen"],
    "buttons": {"0": "left / touch / pen tip", "1": "right", "2": "middle", "3": "side", "4": "extra", "5": "forward", "6": "back", "7": "task"}
  },
  "context": {
    "$comment": "The `context` object JavaScript sees. `sandboxes` says where a key exists: a code node (one expression) or an app (a module).",
    "keys": [
      {"name": "event", "type": "event", "sandboxes": ["code", "app"], "description": "The name of the event this run is handling."},
      {"name": "payload", "type": "payload", "sandboxes": ["code", "app"], "description": "That event's payload."},
      {"name": "loopIndex", "type": "integer", "sandboxes": ["code", "app"], "description": "Index of the current iteration inside a loop."},
      {"name": "loopKey", "type": "string", "sandboxes": ["code", "app"], "description": "Key of the current iteration inside a loop."},
      {"name": "hasImage", "type": "boolean", "sandboxes": ["code", "app"], "description": "Whether the run carries a canvas."},
      {"name": "nextSleep", "type": "float", "sandboxes": ["app"], "description": "Seconds until the next render."},
      {"name": "image", "type": "image", "optional": true, "sandboxes": ["app"], "description": "The canvas, when there is one."},
      {
        "name": "imageWidth",
        "type": "integer",
        "optional": true,
        "sandboxes": ["code", "app"],
        "description": "Width of the canvas. In scene pixels, of the canvas this run draws on (a cell's inside render/split); absent when the run has none."
      },
      {
        "name": "imageHeight",
        "type": "integer",
        "optional": true,
        "sandboxes": ["code", "app"],
        "description": "Height of the canvas. In scene pixels, of the canvas this run draws on (a cell's inside render/split); absent when the run has none."
      }
    ]
  },
  "logEvents": {
    "$comment": "Log lines (not scene events) a control plane derives state from. `sceneChanged`: the frame now shows `sceneId`. `sceneStateChanged`: re-read the frame's state.",
    "sceneChanged": ["render:scene", "render:sceneChange", "event:setCurrentScene"],
    "sceneStateChanged": ["event:setSceneState", "event:setCurrentScene", "event:uploadScenes"]
  },
  "events": [
    {
      "name": "init",
      "class": "lifecycle",
      "description": "Once per scene, when it is first loaded and its apps are ready — before its first open and render.",
      "listen": true,
      "dispatch": false,
      "payload": [],
      "sceneState": "read",
      "origins": ["system", "http:admin"],
      "renderAfter": "if-state-changed",
      "coalesce": "none",
      "log": "full",
      "hosts": {"linux": true, "esp32": true, "wasm": true},
      "since": "2026.9.21"
    },
    {
      "name": "render",
      "class": "lifecycle",
      "description": "Render the scene. Triggered according to the frame's refresh interval, or when explicitly requested.",
      "listen": true,
      "dispatch": true,
      "payload": [],
      "sceneState": "read",
      "origins": ["system", "driver", "preview", "scene", "schedule", "http:write", "http:admin", "cloud"],
      "cloud": {"verb": "render"},
      "renderAfter": "always",
      "coalesce": "none",
      "log": "full",
      "hosts": {"linux": true, "esp32": true, "wasm": true}
    },
    {
      "name": "open",
      "class": "lifecycle",
      "description": "Every time the scene becomes the frame's current scene: at boot, and whenever the frame switches to it, including switching back.",
      "listen": true,
      "dispatch": false,
      "payload": [
        {"name": "sceneId", "label": "Scene", "type": "scene", "required": true}
      ],
      "origins": ["system", "http:admin"],
      "renderAfter": "if-state-changed",
      "coalesce": "none",
      "log": "full",
      "hosts": {"linux": true, "esp32": true, "wasm": true},
      "since": "2026.9.21"
    },
    {
      "name": "close",
      "class": "lifecycle",
      "description": "When the frame switches away from the scene to another one. Carries no payload.",
      "listen": true,
      "dispatch": false,
      "payload": [],
      "origins": ["system", "http:admin"],
      "renderAfter": "never",
      "coalesce": "none",
      "log": "full",
      "hosts": {"linux": true, "esp32": true, "wasm": true},
      "since": "2026.9.21"
    },
    {
