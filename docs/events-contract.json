  "gestures": {
    "$comment": "How the dispatcher makes tap, doubleTap, longPress and swipe out of pointerDown / pointerUp, in scene pixels and milliseconds. The same numbers on every host.",
    "tapSlopPx": 16,
    "tapMs": 500,
    "doubleTapMs": 350,
    "longPressMs": 500,
    "swipeMinPx": 48,
    "directions": ["left", "right", "up", "down"]
  },
  "buttons": {
    "$comment": "GPIO buttons. `roles` is what a button MEANS, so a store scene filters on `role: \"next\"` and not on a silkscreen label; a frame configures a role per button (`gpioButtons[].role`), and `roleByLabel` is the default for a button without one, by its label (case-insensitive). `actions`: `press` on the edge, `longPress` once after `longPressMs` held, `repeat` every `repeatMs` after that, `release` with `durationMs`.",
    "roles": ["primary", "secondary", "next", "prev", "up", "down", "back", "menu", "refresh"],
    "roleByLabel": {
      "A": "primary", "B": "next", "C": "prev", "D": "back", "BOOT": "primary", "KEY1": "next", "KEY2": "prev",
      "KEY3": "next", "BUTTON": "primary", "POWER": "primary", "OK": "primary", "ENTER": "primary",
      "SELECT": "primary", "HOME": "menu", "MENU": "menu", "EXIT": "back", "BACK": "back", "NEXT": "next",
      "RIGHT": "next", "PREV": "prev", "LEFT": "prev", "UP": "up", "DOWN": "down", "REFRESH": "refresh"
    },
    "actions": ["press", "longPress", "repeat", "release"],
    "longPressMs": 500,
    "repeatMs": 250
  },
