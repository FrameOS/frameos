      "output": [
        {
          "id": "s1",
          "nodes": [{ "id": "a", "type": "app", "data": { "keyword": "data/immich", "config": { "mode": "album" } } }]
        }
      ]
    },
    {
      "name": "restore: other scene apps stay",
      "op": "restore",
      "input": [
        {
          "id": "s1",
