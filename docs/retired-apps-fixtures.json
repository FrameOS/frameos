{
  "$comment": "Conformance corpus for the retired-app transform (docs/retired-apps.md). Each case runs `op` on `input` and must produce `output`. `retire` and `restore` take the scenes array; `forRuntime` also takes `runtimeVersion` (null = unknown). An app entry written as the string \"@repo/apps/code/immich\" stands for the full scene-local app the runner builds from that folder: the app's config.json keys plus `origin` and `sources` (every file of the folder). Runners: backend/app/utils/tests/test_retired_apps.py, cloud/apps/auth-web/src/lib/retired-apps.test.ts.",
  "cases": [
    {
      "name": "retire: a data/immich node becomes the scene-local JS app",
      "op": "retire",
      "input": [
        {
          "id": "s1",
          "nodes": [
            { "id": "n1", "type": "app", "data": { "keyword": "render/image", "config": {} } },
            {
              "id": "n2",
              "type": "app",
              "data": { "keyword": "data/immich", "config": { "mode": "album", "albumId": "a-1" }, "cache": { "enabled": true } }
            }
          ],
          "edges": [{ "id": "e1", "source": "n2", "sourceHandle": "fieldOutput", "target": "n1", "targetHandle": "fieldInput/image" }]
        }
      ],
      "output": [
        {
          "id": "s1",
          "nodes": [
            { "id": "n1", "type": "app", "data": { "keyword": "render/image", "config": {} } },
            {
              "id": "n2",
              "type": "app",
              "data": { "keyword": "immich", "config": { "mode": "album", "albumId": "a-1" }, "cache": { "enabled": true } }
            }
          ],
          "edges": [{ "id": "e1", "source": "n2", "sourceHandle": "fieldOutput", "target": "n1", "targetHandle": "fieldInput/image" }],
          "apps": { "immich": "@repo/apps/code/immich" }
        }
      ]
    },
    {
      "name": "retire: two nodes share one app entry",
      "op": "retire",
      "input": [
        {
          "id": "s1",
          "nodes": [
            { "id": "a", "type": "app", "data": { "keyword": "data/immich", "config": { "mode": "favorites" } } },
            { "id": "b", "type": "app", "data": { "keyword": "data/immich", "config": { "mode": "memories" } } }
          ]
        }
      ],
      "output": [
        {
          "id": "s1",
          "nodes": [
            { "id": "a", "type": "app", "data": { "keyword": "immich", "config": { "mode": "favorites" } } },
            { "id": "b", "type": "app", "data": { "keyword": "immich", "config": { "mode": "memories" } } }
          ],
          "apps": { "immich": "@repo/apps/code/immich" }
        }
      ]
    },
    {
      "name": "retire: an already converted scene is left alone",
      "op": "retire",
      "input": [
        {
          "id": "s1",
          "nodes": [{ "id": "a", "type": "app", "data": { "keyword": "immich", "config": {} } }],
          "apps": { "immich": { "origin": "repo/apps/code/immich", "name": "Immich (edited)", "sources": { "app.ts": "export function get() {}" } } }
        }
      ],
      "output": [
        {
          "id": "s1",
          "nodes": [{ "id": "a", "type": "app", "data": { "keyword": "immich", "config": {} } }],
          "apps": { "immich": { "origin": "repo/apps/code/immich", "name": "Immich (edited)", "sources": { "app.ts": "export function get() {}" } } }
        }
      ]
    },
    {
      "name": "retire: an existing entry with the same origin is reused under its own key",
      "op": "retire",
      "input": [
        {
          "id": "s1",
          "nodes": [
            { "id": "a", "type": "app", "data": { "keyword": "photos", "config": {} } },
            { "id": "b", "type": "app", "data": { "keyword": "data/immich", "config": {} } }
          ],
          "apps": { "photos": { "origin": "repo/apps/code/immich", "sources": { "app.ts": "export function get() {}" } } }
        }
      ],
      "output": [
        {
          "id": "s1",
          "nodes": [
            { "id": "a", "type": "app", "data": { "keyword": "photos", "config": {} } },
            { "id": "b", "type": "app", "data": { "keyword": "photos", "config": {} } }
          ],
          "apps": { "photos": { "origin": "repo/apps/code/immich", "sources": { "app.ts": "export function get() {}" } } }
        }
      ]
    },
    {
      "name": "retire: a different app already named immich pushes the key to immich2",
      "op": "retire",
      "input": [
        {
          "id": "s1",
          "nodes": [
            { "id": "a", "type": "app", "data": { "keyword": "immich", "config": {} } },
            { "id": "b", "type": "app", "data": { "keyword": "data/immich", "config": {} } }
