      "output": [
        {
          "id": "s1",
          "nodes": [
            { "id": "a", "type": "app", "data": { "keyword": "immich", "config": {} } },
            { "id": "b", "type": "app", "data": { "keyword": "immich2", "config": {} } }
          ],
          "apps": {
            "immich": { "origin": "repo/apps/code/jsImage", "sources": { "app.ts": "export function get() {}" } },
            "immich2": "@repo/apps/code/immich"
          }
        }
      ]
    },
    {
      "name": "retire: a node that carries its own sources is self-contained and left alone",
      "op": "retire",
      "input": [
        {
          "id": "s1",
          "nodes": [{ "id": "a", "type": "app", "data": { "keyword": "data/immich", "config": {}, "sources": { "app.nim": "discard" } } }]
        }
      ],
      "output": [
        {
          "id": "s1",
          "nodes": [{ "id": "a", "type": "app", "data": { "keyword": "data/immich", "config": {}, "sources": { "app.nim": "discard" } } }]
        }
      ]
    },
    {
      "name": "restore: the JS app goes back to the Nim keyword and its entry is dropped",
