          ],
          "apps": {
            "panel": { "origin": "repo/apps/code/weatherPanel", "sources": { "app.ts": "export function get() {}" } }
          }
        }
      ]
    },
    {
      "name": "forRuntime: a runtime older than the replacement gets the Nim keyword",
      "op": "forRuntime",
      "runtimeVersion": "2026.10.10",
      "input": [
        {
          "id": "s1",
          "nodes": [{ "id": "a", "type": "app", "data": { "keyword": "immich", "config": {} } }],
          "apps": { "immich": "@repo/apps/code/immich" }
        }
      ],
      "output": [{ "id": "s1", "nodes": [{ "id": "a", "type": "app", "data": { "keyword": "data/immich", "config": {} } }] }]
    },
    {
