      "expect": null
    },
    {
      "name": "a list set by hand is left alone",
      "code": "frameos.writeAsset('x', y)",
      "config": "{\n  \"name\": \"Clever\",\n  \"permissions\": [],\n  \"permissionsAuto\": false\n}\n",
      "expect": null
    },
    {
      "name": "an app that calls nothing asks for nothing",
      "code": "export function get() { return 1 }",
      "config": "{\n  \"name\": \"Plain\"\n}\n",
      "expect": "{\n  \"name\": \"Plain\",\n  \"permissions\": []\n}\n"
    },
    {
      "name": "an app with no config.json gets one",
