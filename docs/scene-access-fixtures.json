  "stamps": [
    {
      "name": "an app with no list gets what its code calls for, after settings",
      "code": "frameos.readAsset('x')",
      "config": "{\n  \"name\": \"Reader\",\n  \"settings\": [\n    \"openAI\"\n  ],\n  \"fields\": []\n}\n",
      "expect": "{\n  \"name\": \"Reader\",\n  \"settings\": [\n    \"openAI\"\n  ],\n  \"permissions\": [\n    \"assets\"\n  ],\n  \"fields\": []\n}\n"
    },
    {
      "name": "with no settings the list goes last",
      "code": "frameos.writeAsset('x', y)",
      "config": "{\n  \"name\": \"Writer\"\n}\n",
      "expect": "{\n  \"name\": \"Writer\",\n  \"permissions\": [\n    \"assets\",\n    \"assets-write\"\n  ]\n}\n"
    },
    {
      "name": "a stale automatic list follows the code",
      "code": "frameos.writeAsset('x', y)",
      "config": "{\n  \"name\": \"Stale\",\n  \"permissions\": [\n    \"assets\"\n  ],\n  \"category\": \"data\"\n}\n",
      "expect": "{\n  \"name\": \"Stale\",\n  \"permissions\": [\n    \"assets\",\n    \"assets-write\"\n  ],\n  \"category\": \"data\"\n}\n"
    },
    {
      "name": "a list that already matches is left alone",
      "code": "frameos.readAsset('x')",
