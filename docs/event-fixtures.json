{
 "$comment": "Conformance corpus of the scene event contract (docs/events-contract.json, prose in docs/events.md). Add a case here first; a runner that disagrees is the bug. Runners: frameos/src/frameos/tests/test_event_fixtures.nim (the Nim runtime every host compiles: allow-list, log policy, and what the interpreter does with a delivered event), embedded/esp32/main/tests/test_fos_events.c through backend/app/tasks/tests/test_esp32_events_contract.py (the firmware's C tables), backend/app/utils/tests/test_events_contract.py (the backend), cloud/apps/auth-web/src/test/events-contract.test.ts (the cloud's event route and schedule validator) and cloud/apps/auth-web/src/test/shared-spa/events-contract.test.ts (the shared SPA and the frameos-wasm package).",
 "version": 1,
 "origins": {
  "$comment": "May `origin` emit `event`? Only the origins a host can tell apart today are asked (contract `enforcedOrigins`, plus http:admin as the control).",
  "cases": [
   {
    "origin": "scene",
    "event": "metrics",
    "allowed": true
   },
   {
    "origin": "schedule",
    "event": "metrics",
    "allowed": true
   },
   {
    "origin": "http:write",
    "event": "metrics",
    "allowed": true
   },
   {
    "origin": "http:admin",
    "event": "metrics",
    "allowed": true
   },
   {
    "origin": "scene",
    "event": "reload",
    "allowed": false,
    "why": "Same, for a reload of every scene."
   },
   {
    "origin": "schedule",
    "event": "reload",
    "allowed": true
   },
   {
    "origin": "http:write",
    "event": "reload",
    "allowed": false,
    "why": "The frame access key must not be able to reboot-loop the device."
   },
   {
    "origin": "http:admin",
    "event": "reload",
    "allowed": true
   },
   {
    "origin": "scene",
    "event": "restart",
    "allowed": false,
    "why": "A scene that restarts the runtime on every render is a boot loop anyone can publish."
   },
   {
    "origin": "schedule",
    "event": "restart",
    "allowed": true
   },
   {
    "origin": "http:write",
    "event": "restart",
    "allowed": false,
    "why": "The frame access key must not be able to reboot-loop the device."
   },
   {
    "origin": "http:admin",
    "event": "restart",
    "allowed": true
   },
   {
    "origin": "scene",
    "event": "reboot",
    "allowed": false,
    "why": "Same, for the whole device."
   },
   {
    "origin": "schedule",
    "event": "reboot",
    "allowed": true
   },
   {
    "origin": "http:write",
    "event": "reboot",
    "allowed": false,
    "why": "The frame access key must not be able to reboot-loop the device."
   },
   {
    "origin": "http:admin",
    "event": "reboot",
    "allowed": true
   },
   {
    "origin": "scene",
    "event": "uploadScenes",
    "allowed": false,
    "why": "Scene code is untrusted: it must not replace the installed scenes past the guards of the push path."
   },
   {
    "origin": "schedule",
    "event": "uploadScenes",
    "allowed": false,
    "why": "A schedule entry carries no origin stamp, so it would smuggle scenes past the guards of the push path."
   },
   {
    "origin": "http:write",
    "event": "uploadScenes",
    "allowed": false,
    "why": "The frame access key is printed on the frame's QR code; it picks scenes, it does not replace them."
   },
   {
    "origin": "http:admin",
    "event": "uploadScenes",
    "allowed": true
   },
   {
    "origin": "scene",
    "event": "render",
    "allowed": true
   },
   {
    "origin": "scene",
    "event": "setCurrentScene",
    "allowed": true
   },
   {
    "origin": "scene",
    "event": "setSceneState",
    "allowed": true
   },
   {
    "origin": "schedule",
    "event": "setCurrentScene",
    "allowed": true
   },
   {
    "origin": "schedule",
    "event": "render",
    "allowed": true
   },
   {
    "origin": "http:write",
    "event": "setCurrentScene",
    "allowed": true
   },
   {
    "origin": "http:write",
    "event": "button",
    "allowed": true
   },
   {
    "origin": "http:write",
    "event": "mouseMove",
    "allowed": true
   },
   {
    "origin": "scene",
    "event": "myCustomEvent",
    "allowed": true
   },
   {
    "origin": "schedule",
    "event": "myCustomEvent",
    "allowed": true
   },
   {
    "origin": "http:write",
    "event": "myCustomEvent",
    "allowed": true
   },
   {
    "origin": "http:admin",
    "event": "myCustomEvent",
    "allowed": true
   }
  ]
 },
