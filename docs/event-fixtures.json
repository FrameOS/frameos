 "log": {
  "$comment": "What the frame log says when a host drains `event` with `payload`: null = no line at all; without `payload` = the name only.",
  "cases": [
   {
    "event": "keyDown",
    "payload": {
     "key": "KEY_P",
     "code": 25
    },
    "logged": {
     "event": "event:keyDown"
    },
    "why": "A key is logged by name only: the log is stored by the control plane and may be sent to the cloud."
   },
   {
    "event": "keyUp",
    "payload": {
     "key": "KEY_P",
     "code": 25
    },
    "logged": {
     "event": "event:keyUp"
    }
   },
   {
    "event": "mouseMove",
    "payload": {
     "x": 1,
     "y": 2
    },
    "logged": null,
    "why": "One per motion report: not logged at all."
   },
   {
    "event": "mouseDown",
    "payload": {
     "button": 1
    },
    "logged": null
   },
   {
    "event": "mouseUp",
    "payload": {
     "button": 1
    },
    "logged": null
   },
   {
    "event": "wheel",
    "payload": {
     "deltaX": 0,
     "deltaY": 1
    },
    "logged": null
   },
   {
    "event": "button",
    "payload": {
     "pin": 5,
     "label": "A",
     "level": 0
    },
    "logged": {
     "event": "event:button",
     "payload": {
      "pin": 5,
      "label": "A",
      "level": 0
     }
    }
   },
   {
    "event": "setCurrentScene",
    "payload": {
     "sceneId": "abc"
    },
    "logged": {
     "event": "event:setCurrentScene",
     "payload": {
      "sceneId": "abc"
     }
    }
   },
   {
    "event": "myCustomEvent",
    "payload": {
     "n": 1
    },
    "logged": {
     "event": "event:myCustomEvent",
     "payload": {
      "n": 1
     }
    }
   },
   {
    "event": "render",
    "payload": null,
    "logged": {
     "event": "event:render",
     "payload": null
    }
   }
  ]
 },
 "sequences": {
  "$comment": "A scene, then events delivered to it one by one. Per step: `listenersRun` = how many event nodes ran; `state` = a subset of the scene's state afterwards (null = not set); `queued` = what the scene dispatched, in order — exact, so [] means nothing; `logged` = log lines that must appear (subset match); `notLogged` = strings that must not appear in any log line of the step.",
  "cases": [
   {
    "name": "a listener runs for its event and no other",
    "why": "Delivery is by name: every event node whose keyword matches runs, nothing else does.",
    "scenes": [
     {
      "id": "fixtures/events/byName",
      "name": "byName",
      "settings": {
       "execution": "interpreted",
       "refreshInterval": 300
      },
      "nodes": [
       {
        "id": "e1",
        "type": "event",
        "data": {
         "keyword": "button"
        }
       },
       {
        "id": "a1",
        "type": "app",
        "data": {
         "keyword": "logic/setAsState",
         "config": {
          "stateKey": "gotButton",
          "valueJson": true
         }
        }
       },
       {
        "id": "e2",
        "type": "event",
        "data": {
         "keyword": "keyDown"
        }
       },
       {
        "id": "a2",
        "type": "app",
        "data": {
         "keyword": "logic/setAsState",
         "config": {
          "stateKey": "gotKey",
          "valueJson": true
         }
        }
       }
      ],
      "edges": [
       {
        "id": "x1",
        "source": "e1",
        "sourceHandle": "next",
        "target": "a1",
        "targetHandle": "prev"
       },
       {
        "id": "x2",
        "source": "e2",
        "sourceHandle": "next",
        "target": "a2",
        "targetHandle": "prev"
       }
      ],
      "fields": []
     }
    ],
    "scene": "fixtures/events/byName",
    "steps": [
     {
      "send": {
       "event": "button",
       "payload": {
        "pin": 5,
        "label": "A",
        "level": 0
       }
      },
      "listenersRun": 1,
      "state": {
       "gotButton": true,
       "gotKey": null
      }
     },
     {
      "send": {
       "event": "keyDown",
       "payload": {
        "key": "KEY_A",
        "code": 30
       }
      },
      "listenersRun": 1,
      "state": {
       "gotKey": true
      }
     },
     {
      "send": {
       "event": "mouseDown",
       "payload": {
        "button": 1
       }
      },
      "listenersRun": 0
     }
    ]
   },
