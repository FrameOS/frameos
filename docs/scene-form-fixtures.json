            "value": "clock",
            "access": "public",
            "role": null
          },
          {
            "name": "album",
            "label": null,
            "type": "string",
            "value": null,
            "access": "public",
            "role": null
          },
          {
            "name": "refreshInterval",
            "label": "Refresh interval (seconds)",
            "type": "float",
            "value": "300",
            "access": "public",
            "role": "refreshInterval"
          }
        ],
        "visible": [
          "mode",
          "album",
          "refreshInterval"
        ]
      }
    },
