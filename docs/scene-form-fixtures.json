        "fields": [
          {
            "name": "every",
            "label": null,
            "type": "float",
            "value": "30",
            "access": "public",
            "role": "refreshInterval"
          },
          {
            "name": "refreshInterval",
            "label": null,
            "type": "float",
            "value": null,
            "access": "public",
            "role": null
          }
        ],
        "visible": [
          "every",
          "refreshInterval"
        ]
      }
    },
