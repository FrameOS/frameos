    {
      "name": "and blocks and OR-ed conditions",
      "scene": {
        "id": "a",
        "fields": [
          {
            "name": "a",
            "type": "boolean",
            "access": "public",
            "value": "true"
          },
          {
            "name": "b",
            "type": "string",
            "access": "public",
            "value": ""
          },
          {
            "name": "both",
            "type": "string",
            "access": "public",
            "showIf": [
              {
                "and": [
                  {
                    "field": "a"
                  },
                  {
                    "field": "b",
                    "operator": "notEmpty"
                  }
                ]
              }
            ]
          },
          {
            "name": "either",
            "type": "string",
            "access": "public",
            "showIf": [
              {
                "field": "b",
                "operator": "notEmpty"
              },
              {
                "field": "a",
                "operator": "eq",
                "value": true
              }
            ]
          },
          {
            "name": "emptyB",
            "type": "string",
            "access": "public",
            "showIf": [
              {
                "field": "b",
                "operator": "empty"
              }
            ]
          }
        ]
      },
      "values": [],
      "expect": {
        "fields": [
          {
            "name": "a",
            "label": null,
            "type": "boolean",
            "value": "true",
            "access": "public",
            "role": null
          },
          {
            "name": "b",
            "label": null,
            "type": "string",
            "value": "",
            "access": "public",
            "role": null
          },
          {
            "name": "both",
            "label": null,
            "type": "string",
            "value": null,
            "access": "public",
            "role": null
          },
          {
            "name": "either",
            "label": null,
            "type": "string",
            "value": null,
            "access": "public",
            "role": null
          },
          {
            "name": "emptyB",
            "label": null,
            "type": "string",
            "value": null,
            "access": "public",
            "role": null
          },
          {
            "name": "refreshInterval",
            "label": "Refresh interval (seconds)",
            "type": "float",
            "value": "300",
            "access": "public",
            "role": "refreshInterval"
          }
        ],
        "visible": [
          "a",
          "b",
          "either",
          "emptyB",
          "refreshInterval"
        ]
      }
