# epyc-8: cross-compile legs (6 on a frameos/** push to main and again per
# release), the ESP32 generic firmware and Deploy E2E SSH. Nim/gcc + docker
# jobs; nothing here needs more than a few GB of working set.
CPUS=8
MEMORY=16GiB
DISK=60GiB
LABELS=self-hosted,monster,epyc-8,linux,x64
# No GHA_CACHE_WRITABLE: the cache is read-only here. Nothing on epyc-8
# writes it, and Deploy E2E runs pull requests.
