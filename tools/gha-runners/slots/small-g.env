# epyc-4: one test run fans out 10 of these at once (4 Nim shards, 2
# pixie visual-regression shards, 4 containerised Playwright shards); 28
# slots hold two overlapping runs and most of a third. Same 4-vcpu shape as
# ubuntu-latest. 8G: the measured working set is a fraction of that (the
# "10G" a Playwright shard used to show was page cache, now trimmed).
CPUS=4
MEMORY=8GiB
DISK=40GiB
LABELS=self-hosted,monster,epyc-4,linux,x64
