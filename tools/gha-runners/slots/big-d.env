# epyc-32: Buildroot base-image legs (3 platforms at once on an "all"
# publish) and the release SD image. 32 vCPU each on 48 cores/96 threads:
# three busy bigs split the box ~16 physical cores apiece; a smaller slot
# would only cap a leg running alone. 32G is a working-set ceiling — the
# guest trims its page cache (bin/gha-guest-trim.sh), so a build no longer
# grows into the cap on the host.
CPUS=32
MEMORY=32GiB
DISK=120GiB
LABELS=self-hosted,monster,epyc-32,linux,x64
