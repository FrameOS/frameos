[Unit]
Description=Nightly rebuild of the runner VM image

[Timer]
# Every night, when the pool is idle: the image carries main's dependencies
# (gha-image-warm.sh), so a day-old image is a day of main that every job
# fetches on top. Persistent catches up a run the host slept through.
OnCalendar=*-*-* 03:00:00 UTC
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
