[Unit]
Description=Rebuild the GitHub Actions runner VM image (runner release, main's dependencies)
After=incusd.service network-online.target
Requires=incusd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/srv/gha-runners/bin/gha-image-refresh.sh
# A warm build plus smoke test is about half an hour; past 90 minutes it is stuck.
TimeoutStartSec=90min
