[Unit]
Description=Rebuild the GitHub Actions runner VM image when actions/runner moved on
After=incusd.service network-online.target
Requires=incusd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/srv/gha-runners/bin/gha-image-refresh.sh
# A build plus smoke test is ten minutes; anything past an hour is stuck.
TimeoutStartSec=1h
